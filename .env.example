# Environment
NODE_ENV=development

# Telegram MTProto Credentials
# Lấy từ https://my.telegram.org ( mục API development tools )
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Tự động sinh sau khi chạy `npm run telegram:login`
TELEGRAM_SESSION=
# Username của bot cần crawl (ví dụ: @example_bot hoặc example_bot)
TELEGRAM_BOT_USERNAME=@example_bot

# Google Sheets Configuration
# ID của bảng tính Google Sheets (lấy từ URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Products

# Google Service Account Credentials
# Tạo từ Google Cloud Console -> Service Accounts -> Create Key (JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=my-service-account@postflow-507708.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...==\n-----END PRIVATE KEY-----\n"

# Scheduler Configuration
# Mặc định chạy mỗi đầu giờ (00:00, 01:00, 02:00, ...)
SYNC_CRON=0 * * * *
SYNC_ON_START=true

# Timezone (Mặc định: Asia/Ho_Chi_Minh)
TZ=Asia/Ho_Chi_Minh

# Delay an toàn giữa các request/click Telegram (ms)
TELEGRAM_MIN_DELAY=1200
TELEGRAM_MAX_DELAY=2500
TELEGRAM_RESPONSE_TIMEOUT=15000
